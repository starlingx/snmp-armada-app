ARG BASE
FROM ${BASE}
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get -y update && \
    apt-get -y install --no-install-recommends \
        snmp \
        snmpd \
        stx-snmp-subagent \
    && rm -rf /var/lib/apt/lists/*

# Non-root user for security compliance
ENV SNMP_USER=snmp
ENV SNMP_GROUP=snmp
RUN groupadd -r ${SNMP_GROUP} && \
    useradd -r -g ${SNMP_GROUP} -d /home/${SNMP_USER} -s /bin/bash ${SNMP_USER} && \
    mkdir -p /home/${SNMP_USER} && \
    chown -R ${SNMP_USER}:${SNMP_GROUP} /home/${SNMP_USER}

WORKDIR /home/${SNMP_USER}
RUN cp /usr/bin/snmpSubAgent . && chown ${SNMP_USER}:${SNMP_GROUP} snmpSubAgent
COPY bootstrap.sh .
RUN chmod 755 bootstrap.sh && chown ${SNMP_USER}:${SNMP_GROUP} bootstrap.sh

USER ${SNMP_USER}
ENTRYPOINT ["./bootstrap.sh"]
